<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>netstandard2.0</TargetFramework>
		<LangVersion>latest</LangVersion>
		<ImplicitUsings>disable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
		<AssemblyTitle>Home Screen Companion</AssemblyTitle>
		<AssemblyName>HomeScreenCompanion</AssemblyName>
		<RootNamespace>HomeScreenCompanion</RootNamespace>
		
		<Version>4.4.3.7</Version>
		<!-- "beta" shows "vX.X.X.X beta" in the settings page footer; leave empty for a release. -->
		<ReleaseChannel>dev</ReleaseChannel>
		<InformationalVersion Condition="'$(ReleaseChannel)' != ''">$(Version)-$(ReleaseChannel)</InformationalVersion>

		<Product>Home Screen Companion</Product>

		<!-- MSB3277: the Emby DLLs reference newer System.* versions; Emby supplies them at runtime.
		     NU1903: SkiaSharp is compile-only (not shipped); the plugin runs on Emby's own SkiaSharp. -->
		<NoWarn>$(NoWarn);MSB3277;NU1903</NoWarn>

	</PropertyGroup>

	<ItemGroup>
	  <None Remove="Configuration\configPage.html" />
	  <None Remove="Configuration\configPage.js" />
	  <None Remove="thumb.png" />
	  <None Remove="LemonMilk.otf" />
	  <None Remove="Fonts\*.ttf" />
	</ItemGroup>

	<ItemGroup>
	  <EmbeddedResource Include="Configuration\configPage.html" />
	  <EmbeddedResource Include="Configuration\configPage.js" />
	  <EmbeddedResource Include="thumb.png" />
	  <EmbeddedResource Include="LemonMilk.otf" />
	  <EmbeddedResource Include="Fonts\*.ttf" />
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Include="SkiaSharp" Version="2.88.3" />
	  <PackageReference Include="Microsoft.CSharp" Version="4.7.0" />
	  <PackageReference Include="System.Memory" Version="4.6.0" />
	</ItemGroup>

	<ItemGroup>
	  <Reference Include="MediaBrowser.Common">
	    <HintPath>$(AppData)\Emby-Server\system\MediaBrowser.Common.dll</HintPath>
	    <Private>False</Private>
	  </Reference>
	  <Reference Include="MediaBrowser.Controller">
	    <HintPath>$(AppData)\Emby-Server\system\MediaBrowser.Controller.dll</HintPath>
	    <Private>False</Private>
	  </Reference>
	  <Reference Include="MediaBrowser.Model">
	    <HintPath>$(AppData)\Emby-Server\system\MediaBrowser.Model.dll</HintPath>
	    <Private>False</Private>
	  </Reference>
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="Dependencies\" />
	</ItemGroup>

	<Target Name="InjectVersionIntoHtml" BeforeTargets="BeforeBuild">
		<Exec Command="powershell -Command &quot;$f='$(ProjectDir)Configuration\configPage.html'; (Get-Content $f -Raw) -replace 'Home Screen Companion v[\d.]+', 'Home Screen Companion v$(Version)' | Set-Content $f -NoNewline&quot;" />
	</Target>

</Project>