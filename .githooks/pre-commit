#!/bin/sh
# The build number is bumped when dev is pushed (see pre-push), in the working
# copy only. This hook puts that new number into the next commit on dev, also
# when the csproj is not staged: only the <Version> line of the staged copy is
# changed, so other unstaged changes in the csproj stay out of the commit.
# Merges, rebases, cherry-picks and other branches are left alone; releases
# on beta and main get their version set by hand.
# Turn on once per clone: git config core.hooksPath .githooks

f=HomeScreenCompanion/HomeScreenCompanion.csproj

[ "$(git rev-parse --abbrev-ref HEAD)" = "dev" ] || exit 0

gitdir=$(git rev-parse --git-dir)
for m in MERGE_HEAD CHERRY_PICK_HEAD REVERT_HEAD rebase-merge rebase-apply; do
	[ -e "$gitdir/$m" ] && exit 0
done

ver() { sed -n 's/.*<Version>\([0-9]*\.[0-9]*\.[0-9]*\.[0-9]*\)<\/Version>.*/\1/p' | head -n 1; }
staged=$(git show ":$f" | ver)
work=$(ver < "$f")
[ -n "$staged" ] && [ -n "$work" ] && [ "$staged" != "$work" ] || exit 0

mode=$(git ls-files -s -- "$f" | cut -d' ' -f1)
blob=$(git show ":$f" | sed "s/<Version>$staged<\/Version>/<Version>$work<\/Version>/" | git hash-object -w --stdin --no-filters) || exit 1
git update-index --cacheinfo "$mode,$blob,$f" || exit 1

echo "pre-commit: version $staged -> $work"
